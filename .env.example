# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# .env 는 커밋하지 않는다. docker compose 가 아래 값을 그대로 읽는다.

# --- MySQL ---
# 로컬에서 직접 실행할 때는 localhost,
# docker compose 로 띄울 때는 compose 가 db 로 덮어쓴다.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=여기에_비밀번호
MYSQL_DB=multicam

# --- 외부 API ---
# 주소 검색·경로 조회에 필요하다. 없으면 해당 기능만 동작하지 않는다.
KAKAO_REST_API_KEY=
TMAP_APP_KEY=
